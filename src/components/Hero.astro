---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { makeMesh, meshNodes, meshPath } from '../lib/mesh';
import retrato from '../assets/photos/retrato-recorte.png';

// Campo de malha atrás do retrato: nasce perto da cabeça e se espalha.
const mesh = makeMesh({
  width: 720,
  height: 820,
  cols: 8,
  rows: 10,
  seed: 22270,
  jitter: 0.34,
  origin: { x: 470, y: 230 },
});
const path = meshPath(mesh);
const nodes = meshNodes(mesh).filter((_, i) => i % 3 === 0);

const credenciais = [
  { text: 'Coordenador da Unidade do AVC do Hospital São José', href: '#imprensa' },
  { text: 'Sócio-fundador e diretor técnico da Aura Neurologia', href: '#contato' },
  { text: 'Preceptor da Residência Médica em Neurologia', href: '#trajetoria' },
];
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title">
        <span class="hero__name">Dr. Fernando <span class="nowrap">Topanotti Tarabay</span></span>
        <span class="hero__role">Neurologista em Criciúma/SC</span>
      </h1>
      <p class="hero__reg tabular">{site.crm} · {site.rqe}</p>
    </div>

    <p class="hero__lead">
      Diagnóstico e tratamento das doenças do sistema nervoso, com atendimento humanizado para pacientes acima de 12
      anos.
    </p>

    <div class="hero__actions">
      <a class="btn" href={site.whatsappHref} target="_blank" rel="noopener" data-hero-cta>
        <Icon name="whatsapp" />
        Agendar pelo WhatsApp
      </a>
      <a class="btn btn--ghost" href="#areas">Ver áreas de atuação</a>
    </div>

    <div class="hero__stage">
      <svg
        class="hero__field"
        viewBox={`0 0 ${mesh.width} ${mesh.height}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <radialGradient id="mesh-fade" cx="62%" cy="30%" r="68%">
            <stop offset="0" stop-color="#fff" stop-opacity="1"></stop>
            <stop offset="0.6" stop-color="#fff" stop-opacity="0.6"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </radialGradient>
          <mask id="mesh-mask">
            <rect width="100%" height="100%" fill="url(#mesh-fade)"></rect>
          </mask>
        </defs>
        <g mask="url(#mesh-mask)">
          <path class="hero__edges" d={path} pathLength="1"></path>
          {nodes.map((p) => <circle class="hero__dot" cx={p.x} cy={p.y} r="2.6" />)}
        </g>
      </svg>
      <Picture
        src={retrato}
        alt="Dr. Fernando Topanotti Tarabay, de blazer azul-marinho e óculos"
        formats={['avif']}
        fallbackFormat="webp"
        widths={[300, 420, 560, 760, 940]}
        sizes="(min-width: 1024px) 480px, (min-width: 640px) 340px, 72vw"
        priority
        class="hero__portrait"
        pictureAttributes={{ class: 'hero__picture' }}
      />
    </div>

    <ol class="hero__nodes" role="list" aria-label="Cargos atuais">
      {
        credenciais.map((c, i) => (
          <li style={`--r:${credenciais.length - 1 - i}`}>
            <a href={c.href} class="cred">
              <span class="cred__node" aria-hidden="true" />
              <span class="cred__text">{c.text}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #fff;
    padding-bottom: var(--s-7);
  }

  /*
    Celular e tablet: nome, CRM e botão de agendar primeiro (o botão fica na primeira tela);
    depois a faixa com a malha, o retrato à direita e os três cargos à esquerda; por fim o texto de apoio.
  */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'text'
      'actions'
      'stage'
      'lead';
  }

  .hero__text {
    grid-area: text;
    position: relative;
    z-index: 2;
    padding-top: var(--s-5);
  }

  .hero__actions {
    grid-area: actions;
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .hero__actions .btn--ghost {
    display: none;
  }

  .hero__lead {
    grid-area: lead;
    margin-top: var(--s-5);
    max-width: 40ch;
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--text);
  }

  /* ---------- Faixa: malha + retrato (cortado pela borda de baixo) + cargos ---------- */
  .hero__stage {
    grid-area: stage;
    position: relative;
    overflow: hidden;
    /* Cresce junto com os cargos em telas estreitas (eles dividem a mesma área da grade) */
    min-height: clamp(300px, 46svh, 400px);
    margin-top: var(--s-6);
    margin-inline: calc(-1 * var(--gutter));
    background: var(--ice);
    border-block: 1px solid var(--line);
  }

  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--azure);
    pointer-events: none;
  }

  .hero__edges {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.45;
  }

  .hero__dot {
    fill: #fff;
    stroke: currentColor;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    opacity: 0.75;
  }

  .hero__stage :global(.hero__picture) {
    position: absolute;
    top: 9%;
    right: -15%;
    height: 104%;
  }

  .hero__stage :global(.hero__portrait) {
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

  .hero__nodes {
    grid-area: stage;
    position: relative;
    z-index: 2;
    align-self: center;
    display: grid;
    gap: var(--s-4);
    width: min(50%, 260px);
    margin-top: var(--s-6);
    padding-block: var(--s-5);
  }

  /* A aresta que liga os três cargos */
  .hero__nodes::before {
    content: '';
    position: absolute;
    left: 5.25px;
    top: calc(var(--s-5) + 17px);
    bottom: calc(var(--s-5) + 17px);
    width: 1.5px;
    background: var(--azure);
    transform-origin: bottom;
  }

  /* ---------- Texto ---------- */
  h1 {
    display: grid;
    gap: var(--s-3);
  }

  .hero__name {
    display: block;
    font-size: clamp(42px, 11.6vw, 96px);
    line-height: 0.92;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero__role {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--t-lead);
    line-height: 1.25;
    letter-spacing: 0;
    color: var(--azure);
  }

  .hero__reg {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.01em;
  }

  /* ---------- Cargos (nós) ---------- */
  .cred {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-height: 44px;
    padding: 6px 0;
    color: var(--ink);
    text-decoration: none;
  }

  .cred__node {
    position: relative;
    z-index: 1;
    flex: none;
    width: 12px;
    height: 12px;
    margin-top: 4px;
    border: 2px solid var(--azure);
    border-radius: 50%;
    background: #fff;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .cred__text {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }

  .cred:active .cred__node,
  .cred:focus-visible .cred__node {
    background: var(--azure);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--azure) 18%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .cred:hover .cred__node {
      background: var(--azure);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--azure) 18%, transparent);
    }

    .cred:hover .cred__text {
      color: var(--azure);
    }
  }

  /*
    Entrada (abaixo de 1,2s): as arestas se desenham e os cargos acendem de baixo para cima,
    terminando no cargo mais próximo do botão de agendar.
  */
  @media (prefers-reduced-motion: no-preference) {
    .hero__edges {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 800ms var(--ease-out) forwards;
    }

    .hero__dot {
      animation: dot-in 500ms var(--ease-out) 200ms both;
    }

    .hero__nodes::before {
      animation: grow 500ms var(--ease-out) 200ms both;
    }

    .cred__node {
      animation: light 450ms var(--ease-out) both;
      animation-delay: calc(450ms + var(--r) * 120ms);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dot-in {
    from {
      opacity: 0;
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes light {
    0% {
      background: #fff;
    }
    45% {
      background: var(--azure);
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--azure) 20%, transparent);
    }
    100% {
      background: #fff;
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* Celulares muito estreitos (até 359px): os cargos descem para baixo da foto, sem sobrepor o retrato */
  @media (max-width: 359px) {
    .hero__grid {
      grid-template-areas:
        'text'
        'actions'
        'stage'
        'nodes'
        'lead';
    }

    .hero__stage {
      min-height: 260px;
    }

    .hero__stage :global(.hero__picture) {
      right: 8%;
      height: 118%;
    }

    .hero__nodes {
      grid-area: nodes;
      width: auto;
      margin-top: var(--s-2);
    }
  }

  /* ---------- Tablet ---------- */
  @media (min-width: 640px) {
    .hero__grid {
      grid-template-areas:
        'text'
        'lead'
        'actions'
        'stage';
    }

    .hero__text {
      padding-top: var(--s-7);
    }

    .hero__lead {
      max-width: 44ch;
      font-size: var(--t-lead);
    }

    .hero__actions {
      grid-auto-flow: column;
      justify-content: start;
    }

    .hero__actions .btn--ghost {
      display: inline-flex;
    }

    .hero__stage {
      min-height: clamp(380px, 46svh, 480px);
      margin-top: var(--s-7);
    }

    .hero__stage :global(.hero__picture) {
      right: 4%;
      height: 116%;
    }

    .hero__nodes {
      width: min(44%, 320px);
      margin-top: var(--s-7);
    }

    .cred__text {
      font-size: 16px;
    }

    .hero {
      padding-bottom: 0;
    }
  }

  /* ---------- Desktop: texto à esquerda, retrato inteiro à direita ---------- */
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas:
        'text    stage'
        'lead    stage'
        'actions stage'
        'nodes   stage';
      column-gap: var(--s-6);
      min-height: calc(100svh - var(--header-h));
      max-height: 980px;
    }

    .hero__text {
      padding-top: var(--s-8);
    }

    /* O nome cabe na coluna de texto (7/12) em qualquer largura de desktop */
    .hero__name {
      font-size: clamp(60px, 6.6vw, 96px);
    }

    .hero__lead {
      max-width: 40ch;
    }

    .hero__actions {
      margin-top: var(--s-6);
    }

    .hero__nodes {
      grid-area: nodes;
      align-self: start;
      gap: var(--s-4);
      width: auto;
      max-width: 540px;
      margin-top: var(--s-7);
      margin-bottom: var(--s-8);
      padding-block: 0;
    }

    .hero__nodes::before {
      top: 17px;
      bottom: 17px;
    }

    .cred {
      gap: 14px;
    }

    .cred__node {
      margin-top: 5px;
    }

    .cred__text {
      font-size: 17px;
    }

    .hero__stage {
      min-height: 0;
      margin-top: 0;
      margin-inline: 0 calc(-1 * var(--gutter));
      overflow: visible;
      background: transparent;
      border-block: 0;
    }

    .hero__field {
      inset: 0 0 0 -30%;
      width: 130%;
    }

    .hero__stage :global(.hero__picture) {
      top: auto;
      right: auto;
      left: 50%;
      bottom: 0;
      height: min(calc(100svh - var(--header-h) - 24px), 780px);
      transform: translateX(-54%);
    }
  }
</style>
