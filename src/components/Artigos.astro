---
import Icon from './Icon.astro';
import artigos from '../data/artigos.json';
import { site } from '../data/site';

const meses = [
  'janeiro',
  'fevereiro',
  'março',
  'abril',
  'maio',
  'junho',
  'julho',
  'agosto',
  'setembro',
  'outubro',
  'novembro',
  'dezembro',
];

const lista = artigos.map((a) => {
  // "15 de Maio de 2024" -> data legível e atributo datetime
  const [dia, , mesNome, , ano] = a.date.split(' ');
  const mes = meses.indexOf(mesNome.toLowerCase()) + 1;
  const iso = `${ano}-${String(mes).padStart(2, '0')}-${dia.padStart(2, '0')}`;
  const legivel = `${Number(dia)} de ${mesNome.toLowerCase()} de ${ano}`;
  const palavras = a.fullContent.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
  const minutos = Math.max(1, Math.round(palavras / 200));
  // Dentro do leitor, o título do artigo é o h2: os títulos internos descem um nível.
  const corpo = a.fullContent.replace(/<(\/?)h3>/g, '<$1h4>').replace(/<(\/?)h2>/g, '<$1h3>');
  return { ...a, iso, legivel, minutos, corpo };
});
---

<section class="section artigos" id="artigos" aria-labelledby="artigos-title" data-section>
  <div class="wrap">
    <header class="section__head">
      <h2 id="artigos-title">Artigos para pacientes</h2>
      <p class="section__intro">
        Textos do Dr. Fernando sobre sintomas comuns, diagnóstico e quando procurar um neurologista.
      </p>
    </header>

    <!-- Índice editorial: o artigo mais recente em destaque, os demais numa lista sobre uma aresta. -->
    <ol class="index" role="list">
      {
        lista.map((a, i) => (
          <li class:list={['entry', { 'entry--lead': i === 0 }]}>
            <a class="entry__link" href={`#artigo-${a.id}`} aria-haspopup="dialog">
              <span class="entry__node" aria-hidden="true" />
              <div class="entry__body">
                <p class="entry__meta">
                  <time datetime={a.iso}>{a.legivel}</time>
                  <span aria-hidden="true">·</span>
                  <span>{a.minutos} min de leitura</span>
                </p>
                <h3 class="entry__title">{a.title}</h3>
                <p class="entry__desc">{a.description}</p>
                <span class="entry__cta">
                  Ler o artigo <Icon name="arrow-right" size={18} />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

{
  lista.map((a) => (
    <dialog class="reader" id={`artigo-${a.id}`} aria-labelledby={`artigo-${a.id}-title`} data-article={a.id}>
      <div class="reader__panel">
        <div class="reader__bar">
          <p class="reader__crumb">Artigos</p>
          <button class="reader__close" type="button" aria-label="Fechar artigo" data-article-close>
            <Icon name="x" size={22} />
          </button>
        </div>
        <article class="reader__body">
          <p class="reader__meta">
            <time datetime={a.iso}>{a.legivel}</time>
            <span aria-hidden="true">·</span>
            <span>{a.minutos} min de leitura</span>
          </p>
          <h2 class="reader__title" id={`artigo-${a.id}-title`}>
            {a.title}
          </h2>
          <p class="reader__author">
            Por {site.name} · <span class="nowrap">{site.crm}</span> · <span class="nowrap">{site.rqe}</span>
          </p>
          <div class="prose" set:html={a.corpo} />
          <aside class="reader__cta" aria-label="Agendar consulta">
            <p class="reader__cta-title">Quer conversar sobre isso em consulta?</p>
            <p class="reader__note">
              Este conteúdo é informativo e não substitui a avaliação médica individual.
            </p>
            <a class="btn" href={site.whatsappHref} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              Agendar pelo WhatsApp
            </a>
          </aside>
        </article>
      </div>
    </dialog>
  ))
}

<style>
  /* ---------- Índice editorial ---------- */
  .index {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .entry {
    position: relative;
  }

  /* Aresta azul que liga os nós da lista, do nó atual até o próximo */
  .entry::before {
    content: '';
    position: absolute;
    left: 5.5px;
    top: calc(var(--s-5) + 9px);
    bottom: calc(-1 * var(--s-5) - 9px);
    width: 1px;
    background: color-mix(in srgb, var(--azure) 38%, transparent);
  }

  .entry:last-child::before {
    display: none;
  }

  .entry__link {
    position: relative;
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    column-gap: var(--s-4);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    -webkit-user-select: none;
    user-select: none;
    transition: background-color 200ms ease;
  }

  .entry__node {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    margin-top: 3px;
    border: 2px solid var(--azure);
    border-radius: 50%;
    background: #fff;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .entry__body {
    display: grid;
    gap: 6px;
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    font-size: var(--t-label);
    font-weight: 500;
    line-height: 1.3;
    color: var(--muted);
  }

  .entry__title {
    font-size: 22px;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .entry__desc {
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .entry__cta {
    display: none;
    align-items: center;
    gap: 6px;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--azure);
  }

  .entry__cta :global(.icon) {
    transition: transform 200ms var(--ease-out);
  }

  /* O mais recente: título maior e texto completo */
  .entry--lead .entry__title {
    font-size: clamp(30px, 2.4vw + 20px, 52px);
    line-height: 1;
  }

  .entry--lead .entry__desc {
    display: block;
    font-size: var(--t-lead);
    line-height: 1.5;
    -webkit-line-clamp: unset;
    line-clamp: none;
  }

  .entry--lead .entry__cta {
    display: inline-flex;
    margin-top: var(--s-2);
  }

  /* A luz é o estado */
  .entry__link:active .entry__node,
  .entry__link:focus-visible .entry__node {
    background: var(--azure);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--azure) 18%, transparent);
  }

  .entry__link:active {
    background: var(--ice);
  }

  @media (hover: hover) and (pointer: fine) {
    .entry__link:hover .entry__node {
      background: var(--azure);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--azure) 18%, transparent);
    }

    .entry__link:hover .entry__title {
      color: var(--azure);
    }

    .entry__link:hover .entry__cta :global(.icon) {
      transform: translateX(3px);
    }
  }

  /* Desktop: o mais recente em 7 colunas, os outros cinco em lista nas 5 restantes */
  @media (min-width: 1024px) {
    .index {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: repeat(5, auto);
      column-gap: var(--s-8);
      border-top: 0;
    }

    .entry--lead {
      grid-column: 1;
      grid-row: 1 / span 5;
    }

    .entry:not(.entry--lead) {
      grid-column: 2;
    }

    .entry--lead::before {
      display: none;
    }

    .entry--lead .entry__link {
      height: 100%;
      align-content: start;
      padding: var(--s-6) 0 var(--s-6);
      border-top: 2px solid var(--azure);
      border-bottom: 0;
    }

    .entry--lead .entry__node {
      margin-top: 6px;
    }

    .entry--lead .entry__body {
      gap: var(--s-4);
    }

    .entry:nth-child(2) .entry__link {
      border-top: 1px solid var(--line-strong);
    }

    .entry:not(.entry--lead) .entry__title {
      font-size: 22px;
    }
  }

  /* ---------- Leitor de artigo ---------- */
  .reader {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .reader[open] {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .reader::backdrop {
    background: rgb(13 44 87 / 0.55);
  }

  .reader__panel {
    position: relative;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #fff;
    -webkit-overflow-scrolling: touch;
  }

  .reader[open] .reader__panel {
    animation: sheet-in 380ms var(--ease-drawer);
  }

  .reader[open]::backdrop {
    animation: fade-in 260ms ease;
  }

  @keyframes sheet-in {
    from {
      transform: translateY(32px);
      opacity: 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .reader__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    padding: 0 var(--gutter);
    padding-top: env(safe-area-inset-top, 0px);
    box-sizing: content-box;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .reader__crumb {
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--azure);
  }

  .reader__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -6px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    transition: transform 160ms var(--ease-out);
  }

  .reader__close:active {
    transform: scale(0.94);
  }

  .reader__body {
    width: min(100% - 2 * var(--gutter), 680px);
    margin-inline: auto;
    padding: var(--s-6) 0 calc(var(--s-8) + env(safe-area-inset-bottom, 0px));
  }

  .reader__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--muted);
  }

  .reader__title {
    margin-top: var(--s-3);
    font-size: var(--t-h2);
    line-height: 0.98;
  }

  .reader__author {
    margin-top: var(--s-4);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
    color: var(--muted);
  }

  /* Texto do artigo */
  .prose {
    margin-top: var(--s-5);
    font-size: 18px;
    line-height: 1.7;
    color: var(--text);
  }

  .prose :global(h3) {
    margin-top: var(--s-7);
    margin-bottom: var(--s-3);
    font-size: 26px;
    line-height: 1.08;
  }

  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(h4) {
    margin-top: var(--s-6);
    margin-bottom: var(--s-3);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.12;
    color: var(--ink);
  }

  .prose :global(p) {
    margin-bottom: var(--s-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--s-3);
    margin: 0 0 var(--s-5);
    padding: 0;
    list-style: none;
  }

  .prose :global(ol) {
    counter-reset: item;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 30px;
  }

  .prose :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border: 2px solid var(--azure);
    border-radius: 50%;
  }

  .prose :global(ol > li) {
    counter-increment: item;
  }

  .prose :global(ol > li)::before {
    content: counter(item);
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 22px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    color: var(--azure);
    font-variant-numeric: tabular-nums;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .reader__cta {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    margin-top: var(--s-7);
    padding: var(--s-5);
    border-radius: var(--radius-lg);
    background: var(--ice);
  }

  .reader__cta-title {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 26px;
    line-height: 1.05;
    color: var(--ink);
  }

  .reader__note {
    font-size: var(--t-small);
    color: var(--muted);
    margin-bottom: var(--s-2);
  }

  @media (min-width: 720px) {
    .reader[open] {
      align-items: center;
      padding: var(--s-6);
    }

    .reader__panel {
      max-width: 820px;
      height: auto;
      max-height: calc(100dvh - 2 * var(--s-6));
      border-radius: var(--radius-lg);
    }

    .reader__bar {
      padding-top: 0;
    }

    .reader__body {
      padding-top: var(--s-7);
    }
  }
</style>
